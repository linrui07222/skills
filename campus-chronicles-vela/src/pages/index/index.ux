<template>
  <div class="page">
    <!-- 背景装饰 -->
    <div class="bg-darker" style="width:480px; height:100%; position:fixed; top:0; left:0; opacity:0.3;"></div>

    <!-- 主内容 -->
    <div style="flex-direction:column; align-items:center; justify-content:center; width:480px; flex:1;">
      <!-- 标题区域 -->
      <text class="title" style="font-size:42px; margin-top:60px;">校园物语</text>
      <text class="subtitle" style="font-size:16px; margin-bottom:40px;">你的高中故事即将开始</text>

      <!-- 按钮区域 -->
      <div class="btn btn-primary" style="width:280px;" onclick="onNewGame">
        <text class="btn-primary-text">新游戏</text>
      </div>

      <div class="btn btn-secondary" style="width:280px;" onclick="onContinue" if="{{hasSave}}">
        <text class="btn-secondary-text">继续游戏</text>
      </div>

      <div class="btn btn-secondary" style="width:280px; background-color:#581C87;" onclick="onNGPlus" if="{{hasCompletedEndings}}">
        <text style="font-size:16px; font-weight:bold; color:#E9D5FF;">二周目</text>
      </div>

      <!-- 版本号 -->
      <text style="font-size:12px; color:#475569; margin-top:40px;">v1.0</text>
    </div>
  </div>
</template>

<style>
  @import '../common/style.css';
</style>

<script>
  import router from '@system.router'
  import gamestore from '../common/gamestore'

  export default {
    data: {
      hasSave: false,
      hasCompletedEndings: false,
    },
    onInit() {
      this.checkSaveStatus()
    },
    onShow() {
      this.checkSaveStatus()
    },
    checkSaveStatus() {
      this.hasSave = gamestore.hasSave()
      var state = gamestore.getState()
      if (state.ngplus && state.ngplus.completedEndings && state.ngplus.completedEndings.length > 0) {
        this.hasCompletedEndings = true
      } else {
        this.hasCompletedEndings = false
      }
    },
    onNewGame() {
      gamestore.newGame()
      router.push({
        uri: '/create'
      })
    },
    onContinue() {
      var success = gamestore.loadGame()
      if (success) {
        var state = gamestore.getState()
        if (state.gamePhase === 'ending') {
          router.push({ uri: '/ending' })
        } else {
          router.push({ uri: '/game' })
        }
      }
    },
    onNGPlus() {
      gamestore.loadGame()
      gamestore.startNGPlus()
      router.push({
        uri: '/create'
      })
    },
  }
</script>
